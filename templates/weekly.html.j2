<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AI & Tech Intelligence — Weekly Review · {{ date }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;1,400&family=Source+Serif+4:ital,opsz,wght@0,8..60,300;0,8..60,400;0,8..60,600&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --bg: #f5f4f0; --page: #ffffff; --text: #1a1a1a;
      --muted: #6b6b6b; --light: #aaa; --border: #e4e2dc;
      --accent: #1e5b8a; --accent-bg: #f0f5fa;
      --tag-bg: #eeede8;
      --serif: "Source Serif 4", Georgia, serif;
      --display: "Playfair Display", Georgia, serif;
      --sans: "Inter", system-ui, sans-serif;
    }
    body {
      background: var(--bg); color: var(--text);
      font-family: var(--serif); line-height: 1.7;
      -webkit-font-smoothing: antialiased;
    }
    a { color: var(--accent); text-decoration: none; border-bottom: 1px solid transparent; }
    a:hover { border-bottom-color: var(--accent); }
    .shell {
      max-width: 960px; margin: 0 auto; background: var(--page);
      border-left: 1px solid var(--border); border-right: 1px solid var(--border);
      min-height: 100vh;
    }
    .masthead {
      border-bottom: 3px solid var(--text); padding: 2rem 2.5rem 1.5rem;
    }
    .masthead-top {
      display: flex; justify-content: space-between; align-items: center;
      padding-bottom: 1rem; border-bottom: 1px solid var(--border); margin-bottom: 1.25rem;
    }
    .eyebrow {
      font-family: var(--sans); font-size: 0.65rem; font-weight: 600;
      letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent);
    }
    .meta { font-family: var(--sans); font-size: 0.7rem; color: var(--light); }
    .title {
      font-family: var(--display); font-size: clamp(2rem, 4vw, 3rem);
      font-weight: 700; line-height: 1.05; letter-spacing: -0.02em;
      margin-bottom: 0.4rem;
    }
    .subtitle {
      font-family: var(--serif); font-style: italic; font-weight: 300;
      color: var(--muted); font-size: 1rem;
    }
    .week-stats {
      display: flex; gap: 1.5rem; margin-top: 1rem; font-family: var(--sans);
      font-size: 0.78rem; color: var(--muted); flex-wrap: wrap;
    }
    .week-stats span strong { color: var(--text); font-weight: 600; }
    main { padding: 2rem 2.5rem 3rem; }
    section { margin-bottom: 3rem; }
    .section-label {
      font-family: var(--sans); font-size: 0.7rem; font-weight: 600;
      letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent);
      margin-bottom: 0.5rem;
    }
    .section-head {
      font-family: var(--display); font-size: 1.7rem; font-weight: 700;
      line-height: 1.15; margin-bottom: 1.25rem;
      border-bottom: 1px solid var(--border); padding-bottom: 0.6rem;
    }
    .essay p { margin-bottom: 1.1rem; font-size: 1.02rem; }
    .essay h2, .essay h3 {
      font-family: var(--display); font-weight: 700; margin: 1.6rem 0 0.6rem;
      line-height: 1.2;
    }
    .essay h2 { font-size: 1.35rem; }
    .essay h3 { font-size: 1.15rem; }
    .essay strong { font-weight: 600; }
    .essay ul { margin: 0.6rem 0 1rem 1.3rem; }

    .big-stories { background: var(--accent-bg); border-left: 3px solid var(--accent); padding: 1.1rem 1.3rem; border-radius: 4px; }
    .big-stories .day {
      font-family: var(--sans); font-size: 0.75rem; font-weight: 600;
      letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent);
    }
    .big-stories .headline {
      font-family: var(--display); font-size: 1.05rem; font-weight: 700;
      line-height: 1.3; margin: 0.15rem 0 0.9rem;
    }

    table { width: 100%; border-collapse: collapse; font-family: var(--sans); font-size: 0.82rem; margin: 0.6rem 0 1.3rem; }
    th, td { text-align: left; padding: 0.5rem 0.7rem; border-bottom: 1px solid var(--border); }
    th { font-size: 0.7rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); background: var(--tag-bg); }
    tr:hover td { background: #fafaf7; }

    .scope-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 0.75rem; margin-bottom: 1rem; }
    .scope-card { border: 1px solid var(--border); padding: 0.9rem 1rem; border-radius: 4px; }
    .scope-card .label { font-family: var(--sans); font-size: 0.65rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
    .scope-card .value { font-family: var(--display); font-size: 1.5rem; font-weight: 700; margin-top: 0.15rem; }
    .scope-card .delta-pos { color: #2d6e3e; font-size: 0.8rem; font-family: var(--sans); }
    .scope-card .delta-neg { color: var(--accent); font-size: 0.8rem; font-family: var(--sans); }

    .day-block { margin-bottom: 1.4rem; }
    .day-block .day-head {
      font-family: var(--sans); font-size: 0.72rem; font-weight: 600;
      letter-spacing: 0.08em; text-transform: uppercase;
      color: var(--accent); margin-bottom: 0.4rem;
    }
    .day-block ul { list-style: none; padding-left: 0; margin: 0; }
    .day-block li { font-size: 0.88rem; padding: 0.25rem 0; }
    .day-block .src { color: var(--muted); font-weight: 600; font-size: 0.75rem; }
    .sect-mini { font-family: var(--sans); font-size: 0.7rem; color: var(--muted); margin: 0.4rem 0 0.2rem; font-weight: 500; }

    .footer { border-top: 3px solid var(--text); padding: 1.5rem 2.5rem; background: var(--bg); font-family: var(--sans); font-size: 0.72rem; color: var(--light); line-height: 1.6; }

    @media (max-width: 640px) {
      .shell { border: none; }
      .masthead, main, .footer { padding-left: 1.2rem; padding-right: 1.2rem; }
    }
  </style>
</head>
<body>
<div class="shell">
  <header class="masthead">
    <div class="masthead-top">
      <span class="eyebrow">Weekly Review · Saturday Digest</span>
      <span class="meta">{{ date }}</span>
    </div>
    <h1 class="title">AI & Tech Intelligence</h1>
    <p class="subtitle">Week of {{ week_start }} → {{ week_end }}</p>
    <div class="week-stats">
      <span><strong>{{ days_covered }}</strong> daily issues</span>
      <span><strong>{{ total_sources_active }}</strong> sources active</span>
      <span><strong>{{ new_sources|length }}</strong> new</span>
      <span><strong>{{ cold_count }}</strong> cold</span>
    </div>
  </header>

  <main>
    <section>
      <div class="section-label">Editor's note</div>
      <h2 class="section-head">This Week in AI</h2>
      <div class="essay">
        {% if themes_essay_html %}
        {{ themes_essay_html | safe }}
        {% else %}
        <p><em>Theme synthesis was skipped — see logs.</em></p>
        {% endif %}
      </div>
    </section>

    <section>
      <div class="section-label">The headline of each day</div>
      <h2 class="section-head">Big Stories — Day by Day</h2>
      {% if big_things %}
      <div class="big-stories">
        {% for bt in big_things %}
        <div>
          <div class="day">{{ bt.date }}</div>
          <div class="headline">{% if bt.url %}<a href="{{ bt.url }}">{{ bt.title }}</a>{% else %}{{ bt.title }}{% endif %}</div>
        </div>
        {% endfor %}
      </div>
      {% else %}
      <p><em>No Big Thing entries found for this week.</em></p>
      {% endif %}
    </section>

    <section>
      <div class="section-label">What changed in the source pool</div>
      <h2 class="section-head">Source Scope</h2>
      <div class="scope-grid">
        <div class="scope-card">
          <div class="label">Active this week</div>
          <div class="value">{{ total_sources_active }}</div>
          <div class="{% if delta_count >= 0 %}delta-pos{% else %}delta-neg{% endif %}">{{ delta_sign }}{{ delta_count }} vs last week</div>
        </div>
        <div class="scope-card">
          <div class="label">New this week</div>
          <div class="value">{{ new_sources|length }}</div>
        </div>
        <div class="scope-card">
          <div class="label">Stopped delivering</div>
          <div class="value">{{ dropped_sources|length }}</div>
        </div>
        <div class="scope-card">
          <div class="label">Cold (≥30d silent)</div>
          <div class="value">{{ cold_count }}</div>
        </div>
      </div>

      {% if new_sources %}<p><strong>New:</strong> {{ new_sources|join(", ") }}</p>{% endif %}
      {% if dropped_sources %}<p><strong>Stopped:</strong> {{ dropped_sources|join(", ") }}</p>{% endif %}
      {% if cold_sources %}<p><strong>Flagged cold:</strong> {{ cold_sources|join(", ") }}</p>{% endif %}

      <h3 style="font-family: var(--display); font-size: 1.1rem; margin: 1.5rem 0 0.6rem;">Top 10 Performers (30-day composite)</h3>
      <table>
        <thead><tr><th>#</th><th>Source</th><th>Type</th><th>Composite</th><th>Hit Rate</th><th>Freshness</th><th>Impact</th><th>Active Days</th></tr></thead>
        <tbody>
          {% for row in top_performers %}
          <tr><td>{{ loop.index }}</td><td>{{ row.name }}</td><td>{{ row.type }}</td><td><strong>{{ "%.2f"|format(row.composite) }}</strong></td><td>{{ "%.2f"|format(row.hit_rate) }}</td><td>{{ "%.2f"|format(row.freshness) }}</td><td>{{ "%.2f"|format(row.impact) }}</td><td>{{ row.active_days }}</td></tr>
          {% endfor %}
        </tbody>
      </table>

      {% if discovered_candidates %}
      <h3 style="font-family: var(--display); font-size: 1.1rem; margin: 1.5rem 0 0.6rem;">Discovered Candidates ({{ discovered_candidates|length }})</h3>
      <table>
        <thead><tr><th>Source</th><th>Type</th><th>Why</th></tr></thead>
        <tbody>
          {% for c in discovered_candidates %}
          <tr><td><a href="{{ c.url }}">{{ c.name }}</a></td><td>{{ c.type }}</td><td>{{ c.reason }}</td></tr>
          {% endfor %}
        </tbody>
      </table>
      {% endif %}

      {% if config_pr_url %}
      <p><strong>Config changes PR opened:</strong> <a href="{{ config_pr_url }}">{{ config_pr_url }}</a></p>
      {% endif %}
    </section>

    <section>
      <div class="section-label">Everything we shipped</div>
      <h2 class="section-head">Story Index — The Whole Week</h2>
      {% if story_index %}
        {% for day in story_index %}
        <div class="day-block">
          <div class="day-head">{{ day.date }}</div>
          {% for section in day.sections %}
          <div class="sect-mini">{{ section.title }}</div>
          <ul>
            {% for item in section.items[:5] %}
            <li><span class="src">[{{ item.source_name }}]</span> <a href="{{ item.url }}">{{ item.title[:140] }}</a></li>
            {% endfor %}
          </ul>
          {% endfor %}
        </div>
        {% endfor %}
      {% else %}
      <p><em>Per-day story index unavailable — JSON sidecars start being generated this week, so next weekly will be richer.</em></p>
      {% endif %}
    </section>
  </main>

  <footer class="footer">
    Generated by ai-newsletter on {{ date }} using Claude {{ model }}.<br>
    Daily issues run weekdays at 9 AM IST. Weekly digest runs every Saturday at 9 AM IST.
  </footer>
</div>
</body>
</html>
